<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape>
        <solid android:color="@color/settings_field" /><corners android:radius="12dp" />
        <stroke android:width="3dp" android:color="@color/settings_accent" />
    </shape></item>
    <item android:state_enabled="false"><shape>
        <solid android:color="@color/settings_surface" /><corners android:radius="12dp" />
        <stroke android:width="1dp" android:color="@color/settings_border" />
    </shape></item>
    <item><shape>
        <solid android:color="@color/settings_field" /><corners android:radius="12dp" />
        <stroke android:width="1dp" android:color="@color/settings_border" />
    </shape></item>
</selector>
