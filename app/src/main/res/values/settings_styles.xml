<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="settings_background">#11131B</color>
    <color name="settings_surface">#202430</color>
    <color name="settings_field">#151923</color>
    <color name="settings_border">#424B60</color>
    <color name="settings_text">#F1F5F8</color>
    <color name="settings_muted">#B5C4D0</color>
    <color name="settings_accent">#AFCBFF</color>
    <color name="settings_error">#FFB4AB</color>
    <style name="ThemeOverlay.CustomFrame.Settings" parent="ThemeOverlay.MaterialComponents.Dark">
        <item name="colorPrimary">@color/settings_accent</item>
        <item name="colorOnPrimary">@color/settings_background</item>
        <item name="colorSecondary">@color/settings_accent</item>
        <item name="colorSurface">@color/settings_surface</item>
        <item name="colorOnSurface">@color/settings_text</item>
        <item name="android:colorAccent">@color/settings_accent</item>
    </style>
    <style name="Settings.SectionTitle" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/settings_text</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>
    <style name="Settings.Description" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/settings_muted</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:layout_marginBottom">20dp</item>
    </style>
    <style name="Settings.Input" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_settings_input</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/settings_text</item>
        <item name="android:textColorHint">@color/settings_muted</item>
        <item name="android:textSize">16sp</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">20dp</item>
    </style>
    <style name="Settings.PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">gravity</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">16sp</item>
        <item name="strokeColor">@color/settings_button_stroke</item>
        <item name="strokeWidth">3dp</item>
    </style>
    <style name="Settings.SecondaryButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">gravity</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/settings_key_text</item>
        <item name="backgroundTint">@color/settings_secondary_fill</item>
        <item name="strokeColor">@color/settings_button_stroke</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>
</resources>
